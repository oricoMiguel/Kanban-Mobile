<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F3"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quadro de reposição"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Ao vivo · mais antigos primeiro"
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnOperador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Sair"
            android:textColor="#111111"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnTempos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Tempos ›"
            android:textColor="#111111"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Botão para gerenciar postos e insumos -->
    <TextView
        android:id="@+id/btnGerenciarPostos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="14dp"
        android:text="Gerenciar postos e insumos  ›"
        android:textColor="#111111"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Abas do quadro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabAberto"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="Aberto (0)"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabEmRota"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="Em rota (0)"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabEntregue"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="Entregue (0)"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Mensagem quando não houver cartões -->
    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Nenhum cartão nesta coluna"
        android:textColor="#888888"
        android:visibility="gone" />

    <!-- Lista de cartões -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCartoes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
