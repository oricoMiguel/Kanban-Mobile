<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F6"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/raiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F8F8F6">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/btnFechar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="×"
                android:textSize="25sp"
                android:textColor="#111111"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Novo posto"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#111111"/>

        </LinearLayout>

        <!-- Formulário -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#D5D5D0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome do posto"
                    android:textStyle="bold"
                    android:textColor="#111111"/>

                <EditText
                    android:id="@+id/txtNome"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:hint="Ex.: Posto 14"
                    android:paddingHorizontal="12dp"
                    android:textColor="#111111"
                    android:textColorHint="#777777"
                    android:textSize="15sp"
                    android:backgroundTint="#777777"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Setor"
                    android:textStyle="bold"
                    android:textColor="#111111"/>

                <Spinner
                    android:id="@+id/spSetor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#777777"/>

                <CheckBox
                    android:id="@+id/chkAtivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Posto ativo"
                    android:textColor="#222222"
                    android:buttonTint="#555555"
                    android:checked="true"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Salvar posto"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#222222"
                    app:backgroundTint="#E8E8E5"
                    app:cornerRadius="12dp"
                    app:strokeColor="#BDBDB8"
                    app:strokeWidth="1dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
