<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F8F6"
    android:padding="16dp">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Postos de trabalho"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gerencie os postos cadastrados"
                android:textSize="13sp"
                android:textColor="#777777" />

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAdicionar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Adicionar posto"
            android:src="@android:drawable/ic_input_add"
            app:tint="#FFFFFF"
            app:backgroundTint="#333333"
            app:borderWidth="0dp" />

    </LinearLayout>

    <!-- Cadastro de insumos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNovoInsumo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Cadastrar novo insumo"
        android:textAllCaps="false"
        android:textColor="#222222"
        android:textSize="14sp"
        app:backgroundTint="#E8E8E5"
        app:cornerRadius="12dp"
        app:strokeColor="#D0D0CC"
        app:strokeWidth="1dp" />

    <!-- Mensagem de lista vazia -->
    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Nenhum posto cadastrado."
        android:textSize="14sp"
        android:textColor="#888888"
        android:visibility="gone" />

    <!-- Lista de postos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPostos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

</LinearLayout>
